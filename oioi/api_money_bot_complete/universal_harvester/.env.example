# Environment Configuration for Universal Harvester
# Load these variables to configure API keys and behavior

# Gemini 3.5 Flash API Key (for visual captcha solving)
# Required for the stealth_stack.py ResearchOrchestrator to handle
grid-based, text, and math captcha challenges.
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY_HERE

# 2Captcha API Key (alternative for reCAPTCHA solutions)
# Required if using utils.captcha.py for reCAPTCHA v2/v3/hCaptcha
CAPTCHA_API_KEY=YOUR_2CAPTCHA_API_KEY_HERE

# OpenAI Whisper model for audio captcha solving
# Required for the stealth_stack.py LocalAudioSolver
# Will download and cache locally if not available or if remote is offline
WHISPER_MODEL_SIZE=base

# Remote Kaggle GPU/T4 Model Server Cloudflare Endpoint (optional)
# Set to offload model inference (e.g. Whisper) to a remote Kaggle environment.
KAGGLE_ENDPOINT=https://your-cloudflare-tunnel.trycloudflare.com
# Bright Data Web Unlocker Token
# Required for the stealth_stack.py BrightDataFallback to handle
# obscure challenge types like KeyCAPTCHA, Capy, MTCaptcha
BRIGHTDATA_TOKEN=YOUR_BRIGHTDATA_API_TOKEN_HERE
BRIGHTDATA_ZONE=web_unlocker

# CloakBrowser Configuration
# Set proxy for CloakBrowser if needed (optional)
CLOAKBROWSER_PROXY=

# Google reCAPTCHA Site Keys (for testing)
# Used when configuring platform-specific reCAPTCHA solutions
RECAPTCHA_V2_SITE_KEY_TEST=6Le-vkEUAAAAACMCxJlQHUh2k-6q6b8V9Z5ZtPQ5
RECAPTCHA_V3_SITE_KEY_TEST=6LdwHEUUAAAAAPLQZ0sWdQcXxE-m2R6T3x7Y6Zt

# Environment Selection
# Set to 'stealth' to use stealth_stack.py (Gemini + Whisper + Bright Data)
# Set to 'standard' to use utils.captcha.py (2Captcha API)
ENVIRONMENT=stealth

# Browser Configuration
# Set to false to run CloakBrowser in headless mode (optional)
CLOAKBROWSER_HEADLESS=false

# Debug and Testing
# Set to true to enable verbose logging and debug screenshots
DEBUG_MODE=false