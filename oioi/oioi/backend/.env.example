# Free-tier provider configuration.
# The app can run with zero keys by using keyless image fallbacks.
# Set keys only for the providers you want to enable.

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional defaults
DEFAULT_CHAT_MODEL=google/gemma-4-26b-a4b-it:free
DEFAULT_IMAGE_MODEL=flux
PROVIDER_PRIORITY=openrouter,groq,gemini,cerebras,cohere,cloudflare,pollinations
