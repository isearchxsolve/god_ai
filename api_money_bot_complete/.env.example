# ═══════════════════════════════════════════════════════════
#  API MONEY BOT v3.0 — COMPLETE ENVIRONMENT TEMPLATE
#  Copy to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════

# ── HARVESTER SETTINGS ──
HEADLESS=false
SAVE_SESSION=true
PROXY_SERVER=http://user:pass@ip:port
CAPTCHA_API_KEY=your_2captcha_key

# ── STEALTH STACK (Optional: CloakBrowser + Gemini + Whisper + BrightData) ──
# USE_CLOAKBROWSER=false           # Set true to use CloakBrowser (requires license)
# USE_STEALTH_STACK_CAPTCHA=false  # Set true to use Gemini/Whisper/BrightData CAPTCHA solver
# GEMINI_API_KEY=                  # Google AI Studio API key (https://aistudio.google.com/app/apikey)
# BRIGHTDATA_TOKEN=                # Bright Data Web Unlocker token (https://brightdata.com)
# WHISPER_MODEL=base               # tiny, base, small, medium, large-v3
# CLOAKBROWSER_LICENSE=            # CloakBrowser license key (if applicable)

# ── EMAIL VERIFICATION (Gmail IMAP) ──
# Gmail App Password required (not main password): https://myaccount.google.com/apppasswords
# Enable IMAP in Gmail settings: https://mail.google.com/mail/u/0/#settings/fwdandpop
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

