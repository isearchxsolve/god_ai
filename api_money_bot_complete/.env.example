# ═══════════════════════════════════════════════════════════
#  API MONEY BOT — SAFETY SWITCHES (NEVER SET TRUE UNTIL READY)
# ═══════════════════════════════════════════════════════════
LIVE_MODE=false
TRADING_ENABLED=false
AUTO_PROPOSE=false
AUTO_PUBLISH=false
AUTO_FULFILL=false
AUTO_LIST=false
AUTO_WITHDRAW=false
AUTO_DELIVER=false
MICROTASK_AUTO=false

# Spending Caps
MAX_TRADE_USD=100.0
MAX_BID_USD=500.0
MAX_WITHDRAW_USD=1000.0
MAX_LISTING_PRICE=500.0
ALLOWED_PAIRS=BTCUSDT,ETHUSDT

# Payment Destinations
UPI_ID=your-upi@okbank
BANK_ACCOUNT=0000000000
IFSC_CODE=HDFC0000000
WITHDRAW_DESTINATION=your@email.com

