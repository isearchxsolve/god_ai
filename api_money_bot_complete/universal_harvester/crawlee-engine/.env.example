# Crawlee Engine Configuration
PORT=3001
API_KEY=your-secret-api-key-here

# Proxy Configuration
USE_PROXY=false
PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_ROTATE=true

# Session Persistence
SESSION_DIR=./sessions
SAVE_SESSIONS=true

# Anti-Detection
HEADLESS=false
STEALTH=true
FINGERPRINT_ROTATION=true

# Concurrency
MAX_CONCURRENCY=4
REQUEST_TIMEOUT=60000

# Logging
LOG_LEVEL=info
SAVE_SCREENSHOTS=true
SCREENSHOT_DIR=./screenshots
