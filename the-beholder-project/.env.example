# Life Archive — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` itself.
#
# Secrets referenced by docker-compose.yml (POSTGRES_PASSWORD_FILE, etc.)
# are NOT read from this file — Docker secrets are plain files under
# ./secrets/ (also gitignored). Generate them, e.g.:
#   mkdir -p secrets
#   openssl rand -base64 32 > secrets/postgres_password.txt
#   openssl rand -base64 32 > secrets/redis_password.txt
#   openssl rand -hex 32   > secrets/n8n_encryption_key.txt
#   echo "minio-admin"     > secrets/minio_access_key.txt
#   openssl rand -base64 24 > secrets/minio_secret_key.txt

# --- Infrastructure (docker-compose.yml) ---
POSTGRES_USER=life_archive
NEO4J_AUTH=neo4j/CHANGE_ME_neo4j_password
REDIS_PASSWORD=CHANGE_ME_redis_password
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key
N8N_HOST=life-archive.local

# --- Phase 1 credentials (see 04_CREDENTIAL_REQUIREMENTS.md) ---
# GitHub Personal Access Token (read-only): repo, read:user, read:org,
# user:email, read:project, read:packages
GITHUB_PAT=

# --- AI providers (already configured per 04_CREDENTIAL_REQUIREMENTS.md) ---
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
ZAI_API_KEY=
OPENCODE_API_KEY=

# --- Phase 2 credentials (Google OAuth — NOT required until Phase 2) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Application ---
LIFE_ARCHIVE_ROOT=./LIFE_ARCHIVE
DATABASE_URL=postgresql+asyncpg://life_archive:CHANGE_ME@localhost:5432/life_archive
